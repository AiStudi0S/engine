{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign Data Model",
  "description": "Schema for Brand OS campaign objects",
  "type": "object",
  "required": ["name", "status", "platforms"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": ["draft", "scheduled", "active", "paused", "completed"]
    },
    "objective": {
      "type": "string",
      "enum": ["awareness", "engagement", "lead_gen", "conversion", "retention"]
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["tiktok", "instagram", "youtube", "x", "reddit", "facebook", "linkedin", "email"]
      },
      "minItems": 1
    },
    "budget": {
      "type": "number",
      "minimum": 0
    },
    "budgetAllocation": {
      "type": "object",
      "description": "Platform → fraction (must sum to 1.0)",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "targeting": {
      "type": "object",
      "properties": {
        "ageRange": { "type": "string" },
        "interests": { "type": "array", "items": { "type": "string" } },
        "locations": { "type": "array", "items": { "type": "string" } },
        "excludeAudiences": { "type": "array", "items": { "type": "string" } }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }
      }
    },
    "abVariants": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 2
    },
    "kpiTargets": {
      "type": "object",
      "properties": {
        "impressions": { "type": "integer" },
        "ctr": { "type": "number", "minimum": 0, "maximum": 1 },
        "conversions": { "type": "integer" },
        "roi": { "type": "number" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
