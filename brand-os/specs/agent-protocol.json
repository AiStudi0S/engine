{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Message Protocol",
  "description": "Inter-agent communication message format for Brand OS swarm",
  "type": "object",
  "required": ["agent", "intent", "payload", "priority", "timestamp"],
  "properties": {
    "agent": {
      "type": "string",
      "description": "Unique agent identifier",
      "examples": [
        "brand-intelligence-agent",
        "content-studio-agent",
        "campaign-strategy-agent",
        "distribution-agent",
        "audience-growth-agent",
        "revenue-optimization-agent",
        "analytics-agent",
        "compliance-agent",
        "persona-creator-agent",
        "micro-creator-agent-persona_001"
      ]
    },
    "intent": {
      "type": "string",
      "description": "Action or result intent",
      "examples": [
        "analyze_trends",
        "trends_analyzed",
        "generate_article",
        "article_generated",
        "publish_content",
        "content_published",
        "check_compliance",
        "compliance_approved"
      ]
    },
    "payload": {
      "type": "object",
      "description": "Intent-specific data"
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "normal", "low"],
      "default": "normal",
      "description": "Message priority — critical blocks all lower-priority processing"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of message creation"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Optional ID for tracing multi-agent workflows"
    }
  },
  "additionalProperties": false
}
